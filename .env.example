# ─────────────────────────────────────────────────────────────
#  نمونه پیکربندی کنتاکتور اینستگرام
#  این فایل را به .env کپی کنید و مقادیر را وارد کنید
# ─────────────────────────────────────────────────────────────

# پورت و آدرس عمومی برنامه (برای ریدایرکت OAuth لازم است)
PORT=3000
APP_URL=http://localhost:3000

# ─── اتصال رسمی اینستاگرام (Meta Developer) ───
# از https://developers.facebook.com یک App از نوع Business بسازید
# و Instagram Graph API را به آن اضافه کنید.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ─── اتصال به ایجنت هوش مصنوعی Arena ───
# اگر کلید وارد نشود، برنامه در حالت «ایجنت محلی دمو» کار می‌کند
ARENA_API_URL=https://arena.ai/agent
ARENA_API_KEY=
ARENA_MODEL=arena-agent
